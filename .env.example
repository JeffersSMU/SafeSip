# Copy to .env (or .env.local) for local testing; add the same names in Vercel for deploys.
# Every value here ends up in the browser bundle, so only public keys belong here.
# Never put the Supabase service_role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# CARTO basemaps key (just the key, not a URL): https://carto.com/basemaps/apikey/
VITE_CARTO_API_KEY=your-carto-key

# Optional: a full tile URL template that overrides CARTO, e.g. https://tile.example.com/{z}/{x}/{y}.png
# VITE_MAP_TILE_URL=
